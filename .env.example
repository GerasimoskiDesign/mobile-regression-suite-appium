# Copy to .env and adjust. Every value is optional; defaults are shown.
# The demo accounts below are the public ones printed on the app's own login screen.

# APP_PATH=apps/my-demo-app.apk
# APP_RELEASE=2.3.0

# Use an Appium server you started yourself instead of the one WebdriverIO launches.
# APPIUM_EXTERNAL=true
# APPIUM_HOST=127.0.0.1
# APPIUM_PORT=4723

# Target a specific device (see `adb devices`).
# UDID=emulator-5554
# PLATFORM_VERSION=14

# Slow machine / CI emulator: multiply all waits.
# TIMEOUT_FACTOR=1
# SPEC_FILE_RETRIES=1

# STANDARD_USERNAME=bod@example.com
# STANDARD_USER_PASSWORD=dummy-value
# LOCKED_USERNAME=alice@example.com
# LOCKED_USER_PASSWORD=dummy-value
