{
  "name": "mobile-regression-suite-appium",
  "version": "1.0.0",
  "private": true,
  "description": "Automated mobile regression suite with Appium + WebdriverIO: centralised accessibility-id selectors, page objects, retry and re-login handling, and a manual-to-automated test matrix.",
  "type": "module",
  "license": "MIT",
  "author": "Mario Gerasimoski",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "fetch-app": "node scripts/fetch-app.js",
    "test": "wdio run config/wdio.conf.js",
    "test:suite": "wdio run config/wdio.conf.js --suite",
    "test:known-defects": "node scripts/run-known-defects.js",
    "test:unit": "node scripts/run-unit-tests.js",
    "check:selectors": "node scripts/check-no-xpath.js",
    "matrix": "node scripts/matrix.js",
    "report": "node scripts/junit-summary.js",
    "charts": "node scripts/charts.js",
    "lint": "eslint . && prettier --check . && node scripts/check-no-xpath.js",
    "format": "prettier --write . && eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@wdio/appium-service": "^9.32.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/junit-reporter": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/logger": "^9.29.1",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-mocha": "^11.3.0",
    "espree": "^11.2.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "webdriverio": "^9.32.0"
  }
}
